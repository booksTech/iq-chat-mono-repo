NODE_ENV=development
PORT=5001

# MongoDB Atlas connection string format:
# mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/DATABASE?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/iq-quizz?retryWrites=true&w=majority

# Must be 32+ random characters
JWT_SECRET=b9f4c2e6a0a6e93e8d0b3c7f1f6c4d9b8c0f7a2e5d6c9b1a3e8f2d7c4b6a9e1c...
JWT_EXPIRES_IN=28d

# Frontend origin
CLIENT_URL=http://localhost:5173

# Simple shared secret used for auth payload encryption/decryption (AES-GCM)
AUTH_PAYLOAD_SECRET=a8f3d91c7e2b4f6a9c1d5e7b3a8c0f2d6e9b1c4d7a

# Optional SMTP (forgot-password email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
